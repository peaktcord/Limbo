common --enable_bzlmod
build --enable_runfiles
build --incompatible_enable_cc_toolchain_resolution
build --announce_rc
test --test_output=errors

build --enable_platform_specific_config
build --stamp
build:windows --workspace_status_command="python bazel/workspace_status.py"
build:linux --workspace_status_command="python3 bazel/workspace_status.py"
build:macos --workspace_status_command="python3 bazel/workspace_status.py"
